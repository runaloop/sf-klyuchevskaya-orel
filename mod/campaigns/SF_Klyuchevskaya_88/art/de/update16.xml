<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="MARINEMELDUNG" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******G E H E I M*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="MARINEMINISTERIUM" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					SOFORT
					<LineBreak/>
					O 08 0200Z MAR 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="VON"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="ROTBANNER-PAZIFIKFLOTTE"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="AN"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="KOMMANDANT"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="INFO"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10. OPERATIVE STAFFEL"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="11. OPERATIVE STAFFEL"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="10. U-BOOT-DIVISION"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="BETR"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="TAGESLAGEBERICHT"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					GEHEIM
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (S) ZUSAMMENFASSUNG: SF Klyuchevskaya und SF Narod liegen in Sasebo. Guam wird durch Trägerluftfahrzeuge der KITTY HAWK stark verstärkt. Die CONSTELLATION-Trägerkampfgruppe befindet sich wahrscheinlich auf dem Weg nach Guam, voraussichtliche Ankunft in den nächsten 4 Tagen. Erreicht die CONSTELLATION Guam, wird die vereinte Luftstreitkraft einer USN-Trägerkampfgruppe und eines verstärkten USAF-Stützpunkts es den USA ermöglichen, Bombenangriffe gegen Japan ungestraft durchzuführen.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) FEINDLAGE:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- CONSTELLATION am 06 2343Z MAR 88 300 sm westlich von Hawaii geortet. Ihre Geleitgruppe umfasst mindestens 2 CG, 2 DD und 3 oder mehr der neuen Langrumpf-Ableitung der Oliver-Hazard-Perry-Klasse. Kurs und Geschwindigkeit deuten darauf hin, dass sie in 4 Tagen in den Luftschirm von Guam eintreten wird.
					<LineBreak/>
					- KITTY HAWK am 07 0015Z MAR 88 500 sm östlich von Hawaii geortet, scheint nach San Diego überzugehen. Nationale technische Aufklärungsmittel legen nahe, dass dieser Träger zu umfassenden Instandsetzungen ins amerikanische Mutterland verlegt wird.
					<LineBreak/>
					- Okinawa und Iwo Jima gestern von den Langstreckenfliegerkräften der VVS niedergehalten. Flugfelder auf beiden Inseln neutralisiert. Keine feindliche Luftaktivität von diesen Standorten zu erwarten.
					<LineBreak/>
					- Guam mit HAWK-Batterien aus Westeuropa verstärkt. HUMINT-Berichte über 3 oder mehr Staffeln Trägerflugzeuge, wahrscheinlich von der KITTY HAWK, die vor 20 Stunden dort gelandet sind.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) EIGENE LAGE:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- SF Klyuchevskaya wird zusammen mit Verstärkungen der Nordflotte in den nächsten 24 Stunden gegen die CONSTELLATION-Trägerkampfgruppe auslaufen.
					<LineBreak/>
					- Die 143. Seeflieger-Raketendivision bleibt in höchster Bereitschaft. Die gesamte Division wurde zur Unterstützung des kommenden Auslaufens von SF Klyuchevskaya nach Japan verlegt.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) LAGE VERBÜNDETER / REGIONALE LAGE: Die Armee bereitet Landungen gegen Okinawa und Iwo Jima vor, in Vorbereitung auf die Luftkampagne gegen Guam.
					<LineBreak/>
					Die Langstreckenfliegerkräfte der VVS im reduzierten Einsatztempo, in Vorbereitung auf die Luftkampagne gegen Guam.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) ANMERKUNGEN DES KOMMANDEURS: Die 7. US-Flotte verfügt nur noch über einen Träger. Wenn wir die CONSTELLATION versenken, werden die USA an den Verhandlungstisch gezwungen. Das Ende des Krieges ist in Sicht. KTOF sendet.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					GEZEICHNET: Khvatov
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					GEHEIM DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
