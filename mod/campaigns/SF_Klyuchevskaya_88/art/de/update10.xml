<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="MARINEMELDUNG" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******G E H E I M*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="MARINEMINISTERIUM" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					SOFORT
					<LineBreak/>
					O 26 0200Z FEB 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="VON"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="ROTBANNER-PAZIFIKFLOTTE"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="AN"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="KOMMANDANT"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="KOPIE"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10. OPERATIVE STAFFEL"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="55. MARINEINFANTERIEDIVISION"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="14. LANDUNGSSCHIFF-BRIGADE"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="BETR"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="TAGESLAGEBERICHT"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					GEHEIM
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (S) ZUSAMMENFASSUNG: SF Narod durchquerte die Straße von Malakka unbehelligt, auf dem Weg nach Cam Ranh Bay, voraussichtliche Ankunft 28. FEB 88. SF Narod wird nach dem Anlegen in Cam Ranh dem Kommando der KTOF unterstellt.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) FEINDLAGE:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- Der Kessel von Kushiro wurde bis auf 10 km vom Stadtzentrum zurückgedrängt. Schwere Verluste auf japanischer Seite, die Kapitulation des Kessels wird in den nächsten 7 Tagen erwartet.
					<LineBreak/>
					- CONSTELLATION am 26 2301Z FEB 88 200 sm östlich von Pearl Harbor geortet, vermutlich auf dem Weg nach Pearl Harbor, wahrscheinlich zur Versorgung.
					<LineBreak/>
					- NIMITZ, am 26 2228Z FEB 88 300 sm nordöstlich von Iwo Jima geortet, scheint auf Position zu verharren.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) EIGENE LAGE:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- SF Klyuchevskaya trifft mit dem Nachschubverband von Petropawlowsk spätestens 01 0100Z MAR 88 zusammen. Der Nachschubverband ist durch eine Umleitung nach Norden verzögert, um ein bekanntes USN-U-Boot zu umgehen.
					<LineBreak/>
					- Die 14. Landungsschiff-Brigade wird die 55. Marineinfanteriedivision bei Sendai landen, um japanische Landstreitkräfte bei Morioka abzuschneiden.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) LAGE VERBÜNDETER / REGIONALE LAGE: Die Landung der Armee auf den japanischen Hauptinseln erzielt weiterhin bedeutende Erfolge, japanische Landstreitkräfte wurden auf die Ost-West-Linie Akita-Morioka zurückgedrängt. Die Armee meldet niedrige Moral und begrenzten Widerstand unter den japanischen Kräften.
					<LineBreak/>
					Angesichts des unmittelbar bevorstehenden Zusammenbruchs des Kessels von Kushiro verlegt die Armee Kräfte für den Vorstoß auf Tokio.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) ANMERKUNGEN DES KOMMANDEURS: Die unmittelbar bevorstehende Ankunft von SF Narod im Pazifik-Kriegsschauplatz wird die befreundete Seezielfeuerkraft erheblich steigern. Zudem räumt die Armee derzeit mehrere erbeutete Flugfelder in Japan, in den kommenden Wochen ist mit verstärkter befreundeter taktischer Luftunterstützung zu rechnen. KTOF sendet.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					GEZEICHNET: Khvatov
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					GEHEIM DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
