<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080">
  <Viewbox>
    <Border Background="#F3E8CF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="920" Height="1270" Padding="44"
            TextElement.FontFamily="Times New Roman" TextElement.Foreground="#111111" TextElement.FontSize="17">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.45"/>
      </Border.Effect>
      <StackPanel Orientation="Vertical">
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>
        <TextBlock Text="13. FEBRUAR 1988 | ASIA OBSERVER | 30 Cent" Margin="0,14,0,14" FontSize="23" TextAlignment="Center"/>
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>

        <Grid Margin="0,8,0,12">
          <Rectangle Fill="#9B1C1C" Height="16" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
          <TextBlock Text="EILMELDUNG" TextAlignment="Center" FontSize="72" FontWeight="Bold"/>
        </Grid>
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>

        <TextBlock Text="SOWJETS GREIFEN KONVOIS AN"
                   FontWeight="Bold" FontSize="36" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,12"/>
        <TextBlock Text="WASHINGTON BESTÄTIGT MEHRERE BESCHÄDIGTE KONVOIS IM NORDPAZIFIK"
                   FontSize="24" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>

        <Border BorderBrush="#111111" BorderThickness="3" Background="#FFF7DD" Padding="14" Margin="0,0,0,18">
          <TextBlock Text="Konvois nach Süden umgeleitet, um sowjetischen Patrouillen zu entgehen"
                     FontSize="28" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="3*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="TOKIO" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="24">
              Der sowjetische Vorstoß kommt in Sapporo zum Stillstand, während sich die Straßenkämpfe verschärfen.
              <LineBreak/><LineBreak/>
              Nord-Sapporo ist mit den ausgebrannten Wracks Dutzender sowjetischer Panzerfahrzeuge übersät, während die JGSDF eine entschlossene Verzögerungsaktion führt.
              <LineBreak/><LineBreak/>
              Offizielle der japanischen Armee behaupten, sowjetische Panzer stürmten blindlings in Hinterhalte, die Infanterieangriffe seien unkoordiniert.
            </TextBlock>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="CANBERRA" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="24">
              Canberra legt diplomatischen Protest ein, nachdem ein australisches Handelsschiff im Westpazifik torpediert wurde.
              <LineBreak/><LineBreak/>
              Die sowjetische Botschaft erklärt, der Vorfall werde untersucht, die Verantwortlichen bestraft.
              <LineBreak/><LineBreak/>
              Dies ist das erste neutrale Schiff, das in diesem Konflikt versenkt wurde. Westlich orientierte Regierungen erwägen militärische Optionen zum Schutz ihrer eigenen Schifffahrt.
            </TextBlock>
          </StackPanel>
        </Grid>

        <Border BorderBrush="#111111" BorderThickness="2" Padding="12" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="SOWJETISCHE BOMBER GREIFEN TOKIO AN" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="23">
              Ungenannte japanische Amtsträger behaupten, mehrere sowjetische Bomber hätten Häfen und Hafenanlagen in der gesamten Tokio-Bucht getroffen, während Moskau seine Bombenkampagne verschärft.
            </TextBlock>
          </StackPanel>
        </Border>

        <Rectangle HorizontalAlignment="Stretch" Height="3" Fill="#111111"/>
        <TextBlock Text="Im Innern: US-Träger vor Hawaii getroffen | Teile Japans ohne Treibstoff, während die Blockade anhält | Exklusivinterview mit japanischem Soldaten auf Hokkaido" TextWrapping="Wrap" FontSize="17" Margin="0,12,0,10" TextAlignment="Center"/>
        <TextBlock Text="-1-" TextAlignment="Center" FontSize="16"/>
      </StackPanel>
    </Border>
  </Viewbox>
</Page>
