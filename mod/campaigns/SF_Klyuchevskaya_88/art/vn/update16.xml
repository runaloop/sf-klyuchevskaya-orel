<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>
		
        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			
			<TextBlock Grid.Row="0" Grid.Column="0" Text="ĐIỆN VĂN HẢI QUÂN" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******S E C R E T*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="BỘ HẢI QUÂN" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
			
		</Grid>
		
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					IMMEDIATE
					<LineBreak/>
					O 08 0200Z MAR 88
				</TextBlock>
				
				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="FM"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="HẠM ĐỘI THÁI BÌNH DƯƠNG CỜ ĐỎ"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="TO"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="TƯ LỆNH"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="INFO"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="LIÊN ĐỘI TÁC CHIẾN 10"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="LIÊN ĐỘI TÁC CHIẾN 11"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="SƯ ĐOÀN TÀU NGẦM 10"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="SUBJ"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="BÁO CÁO TÌNH HÌNH HÀNG NGÀY"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					SECRET
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (S) TÓM TẮT: SF Klyuchevskaya và SF Narod đang cập cảng Sasebo. Guam được tăng cường mạnh bằng không quân trên hạm từ KITTY HAWK. CVBG CONSTELLATION nhiều khả năng đang trên đường tới Guam, ETA trong 4 ngày tới. Nếu CONSTELLATION đến được Guam, sức mạnh không quân kết hợp của một CVBG Hải quân Mỹ và một căn cứ không quân USAF được tăng viện sẽ cho phép Mỹ ném bom Nhật Bản mà không phải trả giá. 
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) TÌNH HÌNH ĐỊCH:
				</TextBlock>	
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">	
					- CONSTELLATION được xác định cách Hawaii 300nm về phía Tây lúc 06 2343Z MAR 88. Nhóm hộ tống của tàu gồm ít nhất 2x CG, 2x DD và 3+ tàu thuộc biến thể thân dài mới của lớp Oliver Hazard Perry. Hướng đi và tốc độ cho thấy tàu sẽ vào vùng yểm trợ đường không của Guam trong 4 ngày nữa. 
					<LineBreak/>
					- KITTY HAWK được xác định cách Hawaii 500nm về phía Đông lúc 07 0015Z MAR 88, dường như đang hành trình về San Diego. Các phương tiện trinh sát kỹ thuật quốc gia cho thấy tàu sân bay này đang được đưa về lục địa Mỹ để sửa chữa lớn.
					<LineBreak/>
					- Okinawa và Iwo Jima đã bị Không quân Tầm xa VVS chế áp hôm qua. Sân bay trên cả hai đảo đều đã bị vô hiệu hóa. Không dự kiến có hoạt động không quân địch xuất phát từ những địa điểm này. 
					<LineBreak/>
					- Guam được tăng cường các khẩu đội HAWK từ Tây Âu. HUMINT báo cáo 3+ phi đội máy bay trên hạm, nhiều khả năng thuộc KITTY HAWK, đã hạ cánh tại đó 20 giờ trước.
					<LineBreak/>
				</TextBlock>	
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) TÌNH HÌNH TA:
				</TextBlock>	
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- SF Klyuchevskaya cùng lực lượng tăng viện của Hạm đội Phương Bắc Cờ Đỏ sẽ xuất kích trong 24 giờ tới để đánh CVBG CONSTELLATION. 
					<LineBreak/>
					- Sư đoàn Không quân Tên lửa Hải quân 143 vẫn duy trì mức báo động cao. Toàn bộ sư đoàn đã được chuyển căn cứ sang Nhật Bản để hỗ trợ đợt xuất kích sắp tới của SF Klyuchevskaya. 
					<LineBreak/>
				</TextBlock>	
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) TÌNH HÌNH ĐỒNG MINH / KHU VỰC: Lục quân đang chuẩn bị chiến dịch đổ bộ lên Okinawa và Iwo Jima để dọn đường cho chiến dịch không kích Guam. 
					<LineBreak/>
					Không quân Tầm xa VVS giảm nhịp độ hoạt động để chuẩn bị cho chiến dịch không kích Guam.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) NHẬN XÉT CỦA TƯ LỆNH: Hạm đội 7 Hoa Kỳ chỉ còn duy nhất một tàu sân bay trong tay. Khi ta đánh chìm CONSTELLATION, Mỹ sẽ buộc phải ngồi vào bàn đàm phán. Ngày kết thúc chiến tranh đã ở trong tầm mắt. KTOF gửi.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					KÝ: Khvatov
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					SECRET DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
