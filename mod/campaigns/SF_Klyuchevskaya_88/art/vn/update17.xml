<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>
		
        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			
			<TextBlock Grid.Row="0" Grid.Column="0" Text="ĐIỆN VĂN HẢI QUÂN" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******S E C R E T*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="BỘ HẢI QUÂN" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
			
		</Grid>
		
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					FLASH
					<LineBreak/>
					Z 10 0348Z MAR 88
				</TextBlock>
				
				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="FM"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="HẠM ĐỘI THÁI BÌNH DƯƠNG CỜ ĐỎ"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="TO"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="TƯ LỆNH"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="INFO"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="LIÊN ĐỘI TÁC CHIẾN 10"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="LIÊN ĐỘI TÁC CHIẾN 11"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="SƯ ĐOÀN KHÔNG QUÂN TÊN LỬA HẢI QUÂN 143"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="SUBJ"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="SITREP KHẨN"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					SECRET
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					FLASH FLASH FLASH 
					<LineBreak/>
					<LineBreak/>
					1. (S) TÓM TẮT: Phát hiện máy bay trên hạm của địch trên bầu trời Tokyo, phát hiện CVBG CONSTELLATION cách Tokyo 200nm về phía Đông Nam. Các mạng chỉ huy và điều khiển của ta đang rối loạn. Toàn bộ lực lượng sẵn có được điều động để đánh chặn CVBG CONSTELLATION. 
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) TÌNH HÌNH ĐỊCH:
				</TextBlock>	
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">	
					- Máy bay A-6 và A-7 đang ném bom lực lượng của ta tại Tokyo. Ký hiệu trên đuôi cho thấy chúng thuộc không đoàn của CONSTELLATION. 
					<LineBreak/>
					- SIGINT bắt được tín hiệu radar dẫn đường hạ cánh của tàu sân bay Mỹ cách Tokyo 200nm về phía Đông Nam, phỏng đoán là CVBG CONSTELLATION. 
					<LineBreak/>
					- Các đợt tập kích TOMAHAWK từ nhiều hướng nhằm vào trận địa SAM của ta, cho thấy có ít nhất 1 SSN Mỹ trong khu vực. 
					<LineBreak/>
				</TextBlock>	
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) TÌNH HÌNH TA:
				</TextBlock>	
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- SF Klyuchevskaya, cách Tokyo 300nm về phía Tây Nam, phải phát hiện và tiêu diệt CVBG CONSTELLATION với tốc độ cao nhất có thể. 
					<LineBreak/>
					- Mất liên lạc với Sư đoàn Không quân Tên lửa Hải quân 143 sau khi đơn vị này báo cáo có máy bay A-7 gần sở chỉ huy.
					<LineBreak/>
					- Căn cứ không quân chiếm được tại Hamamatsu chưa bị đánh trúng và đang xuất kích tiêm kích.
					<LineBreak/>
					</TextBlock>	
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) TÌNH HÌNH ĐỒNG MINH / KHU VỰC: Sở chỉ huy Lục quân tại chỗ mất liên lạc sau đợt tập kích của A-6. Các mạng chỉ huy và điều khiển của ta đang rối loạn và bị gây nhiễu nặng. KTOF đánh giá địch đang nắm ưu thế trên không tuyệt đối trên khu vực Tokyo. Không còn phương tiện phòng không nào hoạt động hay phản hồi sau các đòn đánh đầu tiên. 
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) NHẬN XÉT CỦA TƯ LỆNH: Bất chấp đòn tập kích bất ngờ này nhằm vào Tokyo, rõ ràng là Mỹ đang tuyệt vọng. Mỹ đã gây thiệt hại nặng nề cho lực lượng của ta tại Tokyo, nhưng họ vẫn chỉ còn lại một tàu sân bay. Đồng chí, nhiệm vụ của đồng chí không thay đổi; hãy đánh chìm CONSTELLATION và buộc Mỹ chấp nhận ngừng bắn. KTOF gửi.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					KÝ: Khvatov
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					FLASH FLASH FLASH 
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					SECRET DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
