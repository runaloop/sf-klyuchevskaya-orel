<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>
		
        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			
			<TextBlock Grid.Row="0" Grid.Column="0" Text="NAVAL MESSAGE" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******S E C R E T*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="NAVY DEPARTMENT" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
			
		</Grid>
		
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					IMMEDIATE
					<LineBreak/>
					O 28 0200Z FEB 88
				</TextBlock>
				
				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="FM"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="RED BANNER PACIFIC FLEET"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="TO"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="COMMANDER"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="INFO"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10th OPERATIONAL SQN"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="55th NAVAL INFANTRY DIV"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="14th LANDING SHIP BDE"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="SUBJ"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="DAILY SITREP"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					SECRET
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (S) SUMMARY: Army now on outskirts of Tokyo, Army detached half of its forces to make run for Kitakyushu to prevent escape of Japanese forces from Tokyo. 
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) ENEMY STATUS:
				</TextBlock>	
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">	
					- Kushiro pocket surrendered 3 hours ago; Hokkaido fully belongs to the USSR and transition to Socialist government complete. 
					<LineBreak/>
					- CONSTELLATION located alongside Pearl Harbor at 27 2345Z Feb 88. National technical means indicated she and her escorts are resupplying, likely to return to sea within next 48 hours. 
					<LineBreak/>
					- NIMITZ, located 500nm North East of Iwo Jima at 24 2228Z FEB 88, appears to be holding station. 
					<LineBreak/>
					- Large convoy departed Pearl Harbour at around 27 1800Z Feb 88. This group seems to be on intercept course with NIMITZ CVBG, expected ETA 02 MAR 88. SIGINT assesses this group as replenishment force for NIMITZ CVBG. 
					<LineBreak/>
				</TextBlock>	
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) FRIENDLY STATUS:
				</TextBlock>	
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">	
					- SF Klyuchevskaya in OPBOX BOGOTYR, will transfer on intercept with NIMITZ replenishment force before it enters NIMITZ CVBG aircover. 
					<LineBreak/>
					- 55th Naval Infantry Division now joining push on Tokyo. 
					<LineBreak/>
				</TextBlock>	
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) ALLIED / REGIONAL STATUS: Army detachment approaching outskirts of Nagoya; Tokyo likely encircled within next 48 hours. Army reports limited Japanese resistance in rural areas, but staunch Japanese resistance at Tokyo outskirts. 
					<LineBreak/>
					Elements of Red Banner Northern Fleet's 11th Submarine Division have completed transit of Arctic Circle and now under KTOF command. 
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) COMMANDER'S COMMENTS: KGB reports its security detachements liquidated the partisans in Hokkaido and on Japanese main islands. They claim local resistance is largely suppressed; it seems it won't be another Afghanistan. Now the question is whether we can corner and destroy remaining USN carrier groups. KTOF sends.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					SIGNED: Khvatov
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					SECRET DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
