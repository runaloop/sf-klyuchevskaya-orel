<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="ВОЕННО-МОРСКОЕ СООБЩЕНИЕ" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******С Е К Р Е Т Н О*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="ВОЕННО-МОРСКОЕ ВЕДОМСТВО" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					СРОЧНОЕ СООБЩЕНИЕ
					<LineBreak/>
					O 24 0200Z ФЕВ 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="ОТ КОГО"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="КРАСНОЗНАМЁННЫЙ ТИХООКЕАНСКИЙ ФЛОТ"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="КОМУ"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="КОМАНДИРУ"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="КОПИЯ"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10-Я ОПЕРАТИВНАЯ ЭСКАДРА"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="55-Я ДИВИЗИЯ МОРСКОЙ ПЕХОТЫ"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="14-Я БРИГАДА ДЕСАНТНЫХ КОРАБЛЕЙ"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="ТЕМА"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="ЕЖЕДНЕВНАЯ СВОДКА"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					СЕКРЕТНО
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (С) ОБЩАЯ ОБСТАНОВКА: Морской десант успешен, японские силы уничтожены в результате двойного окружения западнее Саппоро. Оставшиеся японские силы в беспорядке отходят к Кусиро. Армия начинает вторжение на главные острова Японии.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (С) ОБСТАНОВКА У ПРОТИВНИКА:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- Основная часть японских бронетанковых и артиллерийских частей была переброшена на Хоккайдо ещё до десантной операции у Хакодате. На главных островах Японии теперь очень мало бронетехники и механизированных сил.
					<LineBreak/>
					- КОНСТЕЛЛЕЙШН не обнаружен с 22 0600Z ФЕВ 88, последний раз замечен в 200 морских милях восточнее Йокосуки.
					<LineBreak/>
					- НИМИЦ обнаружен в 150 морских милях севернее Иводзимы в 23 2231Z ФЕВ 88, по всей видимости, удерживает позицию.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (С) ОБСТАНОВКА У СВОИХ СИЛ:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- КУГ «Ключевская» продолжает переход для встречи с силами снабжения из Петропавловска.
					<LineBreak/>
					- 55-я дивизия морской пехоты вновь погрузится на десантные корабли после завершения операций по зачистке.
					<LineBreak/>
					- 14-я бригада десантных кораблей остаётся в Хакодате для будущей десантной операции через пролив.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (С) ОБСТАНОВКА СОЮЗНИКОВ / В РЕГИОНЕ: За последние 72 часа армия добилась значительных успехов. Хакодатско-саппорский котёл полностью уничтожен, оставшиеся японские силы сведены к котлу глубиной 50 км в районе Кусиро.
					<LineBreak/>
					20 часов назад армия воспользовалась обстановкой и захватила плацдарм глубиной 50 км на южном берегу Сангарского пролива. СССР теперь в состоянии вторгнуться на главные острова Японии.
					<LineBreak/>
					ВВС предприняли неудачную атаку на авианосную группу КОНСТЕЛЛЕЙШН 22 февраля 1988, ударная группа понесла тяжёлые потери от F-14 и F-15. Возможности дальней авиации ВВС значительно снижены до прибытия подкреплений с Краснознамённого Северного флота.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (С) КОММЕНТАРИИ КОМАНДУЮЩЕГО: Наконец-то всё идёт по графику. После недавнего десанта армии через пролив и близкого уничтожения кусирского котла мы скоро сможем диктовать американцам условия мира. Возвращение американских авианосных сил в регион беспокоит, но Краснознамённый Тихоокеанский флот не подведёт. КТОФ передаёт.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					ПОДПИСАЛ: Хватов
					<LineBreak/>
					КТОФ
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					СЕКРЕТНО DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
