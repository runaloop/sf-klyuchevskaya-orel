<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="ВОЕННО-МОРСКОЕ СООБЩЕНИЕ" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******С Е К Р Е Т Н О*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="ВОЕННО-МОРСКОЕ ВЕДОМСТВО" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					СРОЧНОЕ СООБЩЕНИЕ
					<LineBreak/>
					O 04 0200Z МАР 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="ОТ КОГО"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="КРАСНОЗНАМЁННЫЙ ТИХООКЕАНСКИЙ ФЛОТ"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="КОМУ"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="КОМАНДИРУ"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="КОПИЯ"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10-Я ОПЕРАТИВНАЯ ЭСКАДРА"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="11-Я ОПЕРАТИВНАЯ ЭСКАДРА"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="14-Я БРИГАДА ДЕСАНТНЫХ КОРАБЛЕЙ"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="ТЕМА"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="ЕЖЕДНЕВНАЯ СВОДКА"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					СЕКРЕТНО
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (С) ОБЩАЯ ОБСТАНОВКА: Токио полностью окружён силами армии и морской пехоты. Китакюсю захвачен при ограниченном сопротивлении японцев. Армия готовит высадку на Кюсю; армия ожидает там также ограниченное сопротивление японцев.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (С) ОБСТАНОВКА ПРОТИВНИКА:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					— Окраины Токио перешли в наши руки, однако в центре города сопротивление остаётся упорным.
					<LineBreak/>
					— КОНСТЕЛЛЕЙШН не обнаружен на снимках, предположительно вышел из Пёрл-Харбора в последние 24 часа.
					<LineBreak/>
					— Уничтожение авианосной группы НИМИЦ значительно сократило американскую авиационную мощь в западной части Тихого океана. Армия сообщает об улучшении снабжения в связи со снижением воздушного противодействия противника.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (С) СОБСТВЕННАЯ ОБСТАНОВКА:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					— КУГ «Ключевская» находится в оперативном районе «БОГАТЫРЬ», удерживает позицию до появления подходящей цели.
					<LineBreak/>
					— 14-я бригада десантных кораблей перейдёт к Китакюсю в поддержку армейских десантов на Кюсю.
					<LineBreak/>
					— КУГ «Народ» вышло из Камрани в 03 1800Z МАР 88. СЛАВА была выделена с кораблями охранения для усиления 17-й оперативной эскадры в Камрани. Ожидается, что в течение следующей недели к боевому составу КТОФ присоединятся мощные надводные силы.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (С) ОБСТАНОВКА У СОЮЗНИКОВ / В РЕГИОНЕ: Армия полностью окружила Токио. Японские наземные силы оказывают упорное сопротивление, ведут бои за каждый дом и превращают каждое высотное здание в противотанковую засаду.
					<LineBreak/>
					ВВС сообщают, что дальняя авиация переоснащена и готова к ударам по надводным силам ВМС США с захваченных японских авиабаз.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (С) КОММЕНТАРИИ КОМАНДУЮЩЕГО: Падение Японии — теперь вопрос не «если», а «когда». Как только падёт Токио, американцы потеряют последние из своих передовых баз. После захвата Кюсю Гуам окажется в лёгкой досягаемости нашей дальней авиации. КТОФ.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					ПОДПИСАНО: Хватов
					<LineBreak/>
					КТОФ
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					СЕКРЕТНО DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
