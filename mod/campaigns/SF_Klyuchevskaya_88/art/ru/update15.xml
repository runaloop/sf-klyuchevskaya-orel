<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="ВОЕННО-МОРСКОЕ СООБЩЕНИЕ" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******С Е К Р Е Т Н О*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="ВОЕННО-МОРСКОЕ ВЕДОМСТВО" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					СРОЧНОЕ СООБЩЕНИЕ
					<LineBreak/>
					O 06 0200Z МАР 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="ОТ КОГО"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="КРАСНОЗНАМЁННЫЙ ТИХООКЕАНСКИЙ ФЛОТ"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="КОМУ"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="КОМАНДИРУ"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="КОПИЯ"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10-я ОПЕРАТИВНАЯ ЭСКАДРА"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="11-я ОПЕРАТИВНАЯ ЭСКАДРА"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="10-я ДИВИЗИЯ ПОДВОДНЫХ ЛОДОК"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="ТЕМА"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="ЕЖЕДНЕВНАЯ СВОДКА"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					СЕКРЕТНО
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (С) СВОДКА: Токио объявил безоговорочную капитуляцию 05 Mar 0000Z, боевые действия на главных островах Японии завершены. Силы США тем не менее продолжают сопротивление, в том числе на японских островах, где размещены американские войска — Окинаве и Иводзиме.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (С) ОБСТАНОВКА ПРОТИВНИКА:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- Окинава и Иводзима усилены дополнительными силами ВВС США и авиацией, перебрасываемой из Западной Европы. Агентурные данные из Германии и с западного побережья США подтверждают переброску не менее 2 эскадрилий F-15C на Западно-Тихоокеанский театр.
					<LineBreak/>
					- КОНСТЕЛЛЕЙШН отсутствует на снимках разведки, предположительно вышла из Пёрл-Харбора в последние 72 часа. В состав её охранения входят не менее 2 крейсеров УРО, 2 эсминцев и 2+ фрегатов нового типа Oliver Hazard Perry удлинённой серии.
					<LineBreak/>
					- КИТТИ-ХОК отсутствует на снимках разведки, предположительно вышла из Пёрл-Харбора в последние 24 часа. По оценке национальных технических средств разведки, авианосец вряд ли находится в полной боеготовности из-за серьёзных повреждений, нанесённых нашей дальней морской авиацией.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (С) СОБСТВЕННАЯ ОБСТАНОВКА:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- КУГ «Ключевская» находится в оперативной зоне БОРОДИНО, встретится с КУГ «Народ» в 150 морских милях восточнее островов Сенкаку и будет сопровождать его до Токийского залива.
					<LineBreak/>
					- КУГ «Народ» в 150 морских милях западнее Тайваня, совершает переход в Йокосуку для отдыха и ремонта, расчётное время прибытия 08 2000Z Mar 26.
					<LineBreak/>
					- 143-я дивизия морской ракетоносной авиации приведена в повышенную готовность в ожидании авианалёта противника на Петропавловск или Северную Японию.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (С) ОБСТАНОВКА У СОЮЗНИКОВ / В РЕГИОНЕ: Сухопутные войска переходят к задачам обеспечения безопасности в послевоенной Японии. Высшее командование сухопутных войск готовит варианты действий на случай высадки на Окинаву или Иводзиму, если США не прекратят боевые действия.
					<LineBreak/>
					Дальняя авиация ВВС также приведена в повышенную готовность в ожидании ударов американских авианосцев по территории Советского Союза.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (С) КОММЕНТАРИЙ КОМАНДУЮЩЕГО: Главные острова Японии теперь полностью под советским контролем. Если КГБ выполнит свою часть уговора, к новому году в западной части Тихого океана будет создана новая социалистическая республика. Вопрос теперь в том, что предпримут оставшиеся американские авианосцы. Сохраняйте бдительность в отношении действий вражеской авиации. КТОФ передаёт.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					ПОДПИСАЛ: Хватов
					<LineBreak/>
					КТОФ
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					СЕКРЕТНО DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
