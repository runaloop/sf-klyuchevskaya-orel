<!-- Pacific Strike CIA memorandum event, adapted from Strike Group Molniya U.S.-voice interstitial format. -->
<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080">
  <Viewbox>
    <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Width="864" Height="1120" Padding="45"
            TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16">
      <Border.Effect>
        <DropShadowEffect />
      </Border.Effect>

      <Border BorderThickness="0,10,10,10" BorderBrush="#FF000000">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="C05084534" Background="#FFFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,-15,0,0" Padding="5,0,5,0" />
          <Grid Grid.Row="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="15"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="15"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="TOP SECRET" TextAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2" TextAlignment="Center" FontFamily="Times New Roman">
              정보총국(GRU)
              <LineBreak/>
              <LineBreak/>
              <Run FontSize="12">모스크바, 62665</Run>
            </TextBlock>
            <TextBlock Grid.Row="4" Grid.Column="3" Text="1988년 2월 17일"/>
            <TextBlock Grid.Row="6" Grid.Column="3" Text="222X1"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="수신:   "/>
            <TextBlock Grid.Row="7" Grid.Column="1" TextWrapping="Wrap">
              소련 해군 총사령부
              <LineBreak/>
              적기 태평양 함대
              <LineBreak/>
              제10잠수함사단//J2//
              <LineBreak/>
              제11잠수함사단//J2//
            </TextBlock>
            <TextBlock Grid.Row="7" Grid.Column="3" TextWrapping="Wrap">
              EO 13526 3.3(b)(1)&gt;25Yrs
              <LineBreak/>
              EO 13526 3.5(c)
            </TextBlock>
            <TextBlock Grid.Row="9" Grid.Column="0" Text="제목:   "/>
            <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Text="니미츠 항모전투단 지휘통신망 감청 내용"/>
          </Grid>
          <TextBlock Grid.Row="2" TextWrapping="Wrap">
            1. 신호정보(SIGINT) 감청소 바랴그가 니미츠 보급선단 격파에 관한 미국 지휘통신을 감청함. 해당 통신은 니미츠 항모전투단의 재무장 및 재보급에 대한 절박한 우려와, 서태평양 지역이 지상 기반 항공전력에만 의존하게 될 가능성을 반영함.
            <LineBreak/>
            <LineBreak/>
            2. 미 해군 지휘통신망은 하와이와 이오지마 사이 보급로를 차단하는 소련 수상 및 수중 전력을 고려하여 니미츠 항모전투단에 진주만으로 최고 속력 이동을 지시함. 니미츠에 내려진 명령에는 대잠 지그재그 기동을 무시하고 최고 속력으로 항해하라는 요구가 포함되어 있으며, 미 해군 항모 대잠기가 항모전투단을 우군 잠수함으로부터 엄호할 수 있는 능력에 대한 낙관적인 의견도 담겨 있음.
            <LineBreak/>
            <LineBreak/>
            3. 니미츠 항모전투단은 제한된 항공유 비축분을 대잠 임무에 집중할 것으로 예상되며, 이로 인해 대함 및 초계전투기(CAP) 출격이 감소할 것으로 보임.
            <LineBreak/>
            <LineBreak/>
			4. 미국 지휘관들은 자국의 제한된 지상 및 항모 기반 항공전력이 우군의 도쿄 포위나 일본 전역 점령을 막기에 부족하다는 것을 인식하고 있음. 태평양 전역에 남은 항모전투단이 2개뿐인 상황에서, GRU는 어느 항모전투단이든 격파될 경우 일본 내 적 저항이 붕괴되고 소련과 미국 간 평화 협상이 시작될 가능성이 높다고 평가함.
            <LineBreak/>
            <LineBreak/>
          </TextBlock>
          <TextBlock TextAlignment="Right" Text="블라들렌 미하일로프, 국장" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="480,500,0,0" Grid.Row="2"/>
          <TextBlock Grid.Row="2" Grid.RowSpan="3" VerticalAlignment="Bottom">
            <Run TextDecorations="Underline">배포: ER / 1988년 3월 1일 (첨부물 포함)s</Run>
            <LineBreak/>
            <LineBreak/>
            원본 - 각 수신자
            <LineBreak/>
               1부 - GRU 제2국
            <LineBreak/>
               1부 - GRU 제6국
            <LineBreak/>
               1부 - GRU 제12국
          </TextBlock>
          <TextBlock Grid.Row="4" Text="TOP SECRET" TextAlignment="Center"/>
        </Grid>
      </Border>
    </Border>
  </Viewbox>
</Page>
