<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="해군 통신문" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******S E C R E T*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="해군성" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					IMMEDIATE
					<LineBreak/>
					O 26 0200Z FEB 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="FM"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="적기 태평양 함대"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="TO"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="지휘관"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="INFO"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="제10작전전대"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="제55해군보병사단"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="제14상륙함여단"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="SUBJ"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="일일 상황보고"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					SECRET
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (S) 요약: 나로드 기동부대는 방해 없이 말라카 해협을 통과, 캄란 만으로 향하고 있으며 도착 예정은 28 FEB 88임. 캄란 항 정박 즉시 나로드 기동부대는 KTOF 지휘 하로 편입될 것.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) 적 상황:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- 구시로 포위망은 시가지 중심에서 10km까지 압박됨. 일본군 측 피해 막대, 향후 7일 내 포위망 항복이 예상됨.
					<LineBreak/>
					- 컨스텔레이션은 26 2301Z FEB 88 기준 진주만 동쪽 200해리에서 위치 확인, 진주만으로 이동하여 재보급할 가능성이 있는 것으로 예상됨.
					<LineBreak/>
					- 니미츠는 26 2228Z FEB 88 기준 이오지마 북동쪽 300해리에서 위치 확인, 정점 대기 중인 것으로 보임.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) 우군 상황:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- 클류쳅스카야 기동부대는 01 0100Z MAR 88까지 페트로파블롭스크-캄차츠키 보급 전력과 합류할 것. 보급 전력은 알려진 미 해군 잠수함을 피하기 위해 북쪽으로 우회하면서 지연됨.
					<LineBreak/>
					- 제14상륙함여단은 센다이에 제55해군보병사단을 상륙시켜 모리오카의 일본 지상군을 차단할 것.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) 동맹/지역 상황: 일본 본토 상륙작전에서 육군은 계속 상당한 전과를 올리고 있으며, 일본 지상군은 아키타-모리오카 동서 전선까지 밀려남. 육군은 일본군의 사기 저하와 제한적인 저항을 보고함.
					<LineBreak/>
					구시로 포위망의 임박한 붕괴로, 육군은 도쿄 공략을 위해 전력을 재배치 중.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) 지휘관 의견: 나로드 기동부대의 태평양 전역 도착이 임박함에 따라 우군 대함 화력이 크게 증가할 것임. 또한 육군이 일본 내 여러 점령 비행장을 소탕 중이니, 향후 몇 주간 우군 전술 항공기가 늘어날 것으로 기대함. KTOF 발신.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					서명: 흐바토프
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					SECRET DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
