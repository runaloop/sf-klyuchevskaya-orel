<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080">
  <Viewbox>
    <Border Background="#F3E8CF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="920" Height="1270" Padding="44"
            TextElement.FontFamily="Times New Roman" TextElement.Foreground="#111111" TextElement.FontSize="17">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.45"/>
      </Border.Effect>
      <StackPanel Orientation="Vertical">
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>
        <TextBlock Text="13 FEBUARY 1988 | ASIA OBSERVER | 30 Cents" Margin="0,14,0,14" FontSize="23" TextAlignment="Center"/>
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>

        <Grid Margin="0,8,0,12">
          <Rectangle Fill="#9B1C1C" Height="16" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
          <TextBlock Text="BREAKING NEWS" TextAlignment="Center" FontSize="72" FontWeight="Bold"/>
        </Grid>
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>

        <TextBlock Text="SOVIETS HIT CONVOYS"
                   FontWeight="Bold" FontSize="36" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,12"/>
        <TextBlock Text="WASHINGTON CONFIRMS SEVERAL CONVOYS DAMAGED IN NORTH PACIFIC"
                   FontSize="24" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>

        <Border BorderBrush="#111111" BorderThickness="3" Background="#FFF7DD" Padding="14" Margin="0,0,0,18">
          <TextBlock Text="Convoys diverted South to avoid Soviet patrols"
                     FontSize="28" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="3*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="TOKYO" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="24">
              Soviet advance stopped cold in Sapporo as urban fighting intensifies. 
              <LineBreak/><LineBreak/>
              Northern Sapporo is covered with the burned out hulks of dozens of Soviet armored vehicles as the JGSDF fights a determined holding action. 
              <LineBreak/><LineBreak/>
              Japanese army officials claim Soviet tanks rushing blind into ambushes, uncoordinated infantry attacks. 
            </TextBlock>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="CANBERRA" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="24">
              Canberra lodges diplomatic protest after Australian merchant torpedoed in Western Pacific. 
              <LineBreak/><LineBreak/>
              Soviet embassy claims incident will be investigated, appropriate parties punished. 
              <LineBreak/><LineBreak/>
              This is the first neutral ship to be sunk in this conflict. Western aligned governments look toward military options to protect their own shipping. 
            </TextBlock>
          </StackPanel>
        </Grid>

        <Border BorderBrush="#111111" BorderThickness="2" Padding="12" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="SOVIET BOMBERS ATTACK TOKYO" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="23">
              Unnamed Japanese officials claim multiple Soviet bombers hit ports and shipping infrastructure throughout Tokyo Bay as Moscow intensifies bombing campaign. 
            </TextBlock>
          </StackPanel>
        </Border>

        <Rectangle HorizontalAlignment="Stretch" Height="3" Fill="#111111"/>
        <TextBlock Text="Inside: US Carrier hit off Hawaii | Parts of Japan out of gas as blockade continues | Exclusive interview with Japanese soldier in Hokkaido" TextWrapping="Wrap" FontSize="17" Margin="0,12,0,10" TextAlignment="Center"/>
        <TextBlock Text="-1-" TextAlignment="Center" FontSize="16"/>
      </StackPanel>
    </Border>
  </Viewbox>
</Page>
