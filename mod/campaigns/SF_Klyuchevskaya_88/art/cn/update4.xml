<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080">
  <Viewbox>
    <Border Background="#F3E8CF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="920" Height="1270" Padding="44"
            TextElement.FontFamily="Times New Roman" TextElement.Foreground="#111111" TextElement.FontSize="17">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.45"/>
      </Border.Effect>
      <StackPanel Orientation="Vertical">
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>
        <TextBlock Text="1988年2月10日 | 亚洲观察报 | 30分" Margin="0,14,0,14" FontSize="23" TextAlignment="Center"/>
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>

        <Grid Margin="0,8,0,12">
          <Rectangle Fill="#9B1C1C" Height="16" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
          <TextBlock Text="突发新闻" TextAlignment="Center" FontSize="72" FontWeight="Bold"/>
        </Grid>
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>

        <TextBlock Text="苏军登陆北海道"
                   FontWeight="Bold" FontSize="36" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,12"/>
        <TextBlock Text="东京证实札幌及周边地区发生激烈战斗。"
                   FontSize="24" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>

        <Border BorderBrush="#111111" BorderThickness="3" Background="#FFF7DD" Padding="14" Margin="0,0,0,18">
          <TextBlock Text="日本官员声称，尽管持续实施空中打击，苏军仍遭受重大损失。"
                     FontSize="28" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="3*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="华盛顿" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="24">
              美国第三舰队下令所有美国和日本商船在阿拉斯加安克雷奇附近的集结点集结。
              <LineBreak/><LineBreak/>
              美国海军预备役人员被征召执行护航任务，美国海军后备船队船只被重新启用用于军事运输。
              <LineBreak/><LineBreak/>
              被困于北太平洋航道的日美油轮争相驶向安全海域。美国第三舰队确认已调派驱逐舰保护航道安全。
            </TextBlock>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="莫斯科声称此为防御性行动" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="24">
              苏联外交团称日本部队蓄意挑起战争，并出示一艘在苏联领海被击沉的日本潜艇作为证据。声称该潜艇奉命攻击苏联军舰。
              <LineBreak/><LineBreak/>
              苏联驻欧使馆暗示，近期的攻势行动仅为阻止"日本的侵略行径"和重燃的军国主义。
              <LineBreak/><LineBreak/>
              北约各国政府呼吁在西太平洋和平解决争端。匿名官员声称军事选项"仍摆在桌面上"，但也存在其他选项。
            </TextBlock>
          </StackPanel>
        </Grid>

        <Border BorderBrush="#111111" BorderThickness="2" Padding="12" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="匿名消息源称苏联袭击部队在北太平洋受损" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="23">
              未具名日本官员称，一支小型苏联海军部队今晨在鄂霍次克海尝试突破未果。初步报告显示，苏联部队在空中和潜艇打击下遭受重大损失。
            </TextBlock>
          </StackPanel>
        </Border>

        <Rectangle HorizontalAlignment="Stretch" Height="3" Fill="#111111"/>
        <TextBlock Text="本期内容：美国航母与苏联轰炸机陷入紧张对峙 | 日本炼油厂被迫停产致油价飙升 | 欧洲各国首都紧急召开会议" TextWrapping="Wrap" FontSize="17" Margin="0,12,0,10" TextAlignment="Center"/>
        <TextBlock Text="-1-" TextAlignment="Center" FontSize="16"/>
      </StackPanel>
    </Border>
  </Viewbox>
</Page>
