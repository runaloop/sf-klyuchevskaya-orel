<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>
		
        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			
			<TextBlock Grid.Row="0" Grid.Column="0" Text="NAVAL MESSAGE" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******S E C R E T*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="NAVY DEPARTMENT" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
			
		</Grid>
		
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					IMMEDIATE
					<LineBreak/>
					O 04 0200Z MAR 88
				</TextBlock>
				
				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="FM"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="RED BANNER PACIFIC FLEET"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="TO"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="COMMANDER"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="INFO"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10th OPERATIONAL SQN"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="11th OPERATIONAL SQN"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="14th LANDING SHIP BDE"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="SUBJ"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="DAILY SITREP"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					SECRET
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (S) SUMMARY: Tokyo completely encircled by Army and Naval Infantry forces. Kitakyushu captured with limited Japanese resistance. Army preparing landing on Kyushu; Army anticpates limited Japanese resistance there as well. 
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) ENEMY STATUS:
				</TextBlock>	
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">	
					- Tokyo outskirts now in friendly hands, however staunch resistance remains in city center. 
					<LineBreak/>
					- CONSTELLATION missing from imagery, expected to have departed Pearl Harbor in last 24 hours.  
					<LineBreak/>
					- Destruction of NIMITZ CVBG has significantly reduced American airpower in Western Pacific. Army reports improved logistics now that enemy air interdiction is reduced. 
					<LineBreak/>
				</TextBlock>	
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) FRIENDLY STATUS:
				</TextBlock>	
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- SF Klyuchevskaya in OPBOX BOGOTYR, holding position until target of opportunity appears. 
					<LineBreak/>
					- 14th Naval Landing Brigade to transit to Kitakyushu in support of Army landings against Kyushu. 
					<LineBreak/>
					- SF Narod departed Cam Ranh Bay at 03 1800Z MAR 88. SLAVA was detached with escorts to reinforce 17th Operational Squadron at Cam Ranh Bay. Expect powerful surface units to join KTOF ORBAT in coming week. 
					<LineBreak/>					
				</TextBlock>	
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) ALLIED / REGIONAL STATUS: Army has completely encircled Tokyo. Japanese ground forces are demonstrating determined resistance, fighting house to house, and turning every high-rise into a anti-tank ambush. 
					<LineBreak/>
					VVS reporting Long Range Aviation refitted, ready for ASuW raids against USN surface forces from captured Japanese bases.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) COMMANDER'S COMMENTS: The fall of Japan is now a question of when and not if. Once Tokyo falls, the Americans will lose the last of their forward bases. Guam is in easy range of friendly Long Range Aviation once Kyushu is captured. KTOF sends.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					SIGNED: Khvatov
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					SECRET DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
