<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
	<!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" Text="1985-8-18" FontSize="{StaticResource Font.Size.Header}"/-->
	<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="{StaticResource Font.Size.Header}">
		SOFORT
		<LineBreak/>
		O 06 0600Z MAR 88
	</TextBlock>
    <!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Text="05:00Z (06:00L)" FontSize="{StaticResource Font.Size.Header}"/-->

    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="VON"/>
    <TextBlock Grid.Row="3" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="ROTBANNER-PAZIFIKFLOTTE"/>
    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="AN"/>
    <TextBlock Grid.Row="4" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="KOMMANDANT {TaskForceName}"/>
	<TextBlock Grid.Row="5" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="INFO"/>
    <TextBlock Grid.Row="5" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}">
		10. OPERATIVE STAFFEL
		<LineBreak/>
		11. OPERATIVE STAFFEL
	</TextBlock>
    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="BETR"/>
    <TextBlock Grid.Row="7" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="OPERATIONSBEFEHL"/>
    <TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="{StaticResource Font.Size.Header}" TextWrapping="Wrap">
		GEHEIM
		<LineBreak/>
		<LineBreak/>
		1. (S) {TaskForceName} muss SF Narod zum Ausgangsbereich eskortieren. Der Feind weiß, dass wir kommen, EMCON ist nicht erforderlich.
		<LineBreak/>
		<LineBreak/>
		2. (S) Unbekannte U-Boot-Bedrohung im Raum; amerikanische SSN bleiben schwer fassbar. Zudem haben mehrere japanische SSK die Kapitulationsanordnung missachtet und sind nicht zum Stützpunkt zurückgekehrt.
		<LineBreak/>
		<LineBreak/>
		3. (S) Feindliche Luftbedrohung mittel, erwarten Sie japanische Luftangriffe von Okinawa. Hohe Wahrscheinlichkeit, dass USAF-Kräfte auf Guam eine Unterbindung mit eskortierten B-52-Verbänden versuchen.
		<LineBreak/>
		<LineBreak/>
		4. (S) Feindliche Überwasserbedrohung mittel, Naha besitzt eine kleine Garnison von 2+ Lenkwaffenzerstörern.
		<LineBreak/>
		<LineBreak/>
		5. (S) Ehemaliger japanischer Flugplatz in Nyutabaru für befreundete Flugzeuge verfügbar.
		<LineBreak/>
		<LineBreak/>
		6. (S) {TaskForceName} nimmt nach der Mission Nachschub in Sasebo auf. Teile von SF Narod schließen sich Ihrem Verband bei Abschluss dieser Mission an. Viel Glück, Genosse.
		<LineBreak/>
		<LineBreak/>
		GEZ.: Khvatov
		<LineBreak/>
		KTOF
		<LineBreak/>
		<LineBreak/>
		GEHEIM
		<LineBreak/>
		DECL OADR BT
	  </TextBlock>
</Grid>
