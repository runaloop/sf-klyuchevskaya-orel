<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
	<!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" Text="1985-8-18" FontSize="{StaticResource Font.Size.Header}"/-->
	<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="{StaticResource Font.Size.Header}">
		SOFORT
		<LineBreak/>
		O 26 0200Z FEB 88
	</TextBlock>
    <!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Text="05:00Z (06:00L)" FontSize="{StaticResource Font.Size.Header}"/-->

    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="VON"/>
    <TextBlock Grid.Row="3" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="ROTBANNER-PAZIFIKFLOTTE"/>
    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="AN"/>
    <TextBlock Grid.Row="4" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="KOMMANDANT {TaskForceName}"/>
	<TextBlock Grid.Row="5" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="KOPIE"/>
    <TextBlock Grid.Row="5" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}">
		10. OPERATIVE STAFFEL
	</TextBlock>
    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="BETR"/>
    <TextBlock Grid.Row="7" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="OPERATIONSBEFEHL"/>
    <TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="{StaticResource Font.Size.Header}" TextWrapping="Wrap">
		GEHEIM
		<LineBreak/>
		<LineBreak/>
		1. (S) {TaskForceName} nimmt Nachschub vom Petropawlowsker Nachschubverband auf.
		<LineBreak/>
		<LineBreak/>
		2. (S) Unbekannte U-Boot-Bedrohung im Raum, jedoch verlegt die 7. US-Flotte vermehrt SSN in den Westpazifik, und viele japanische SSK sind weiterhin unentdeckt.
		<LineBreak/>
		<LineBreak/>
		3. (S) USN-Seefernaufklärer im Raum wahrscheinlich, mit Störangriffen mittels AGM-84D HARPOON erweiterter Reichweite.
		<LineBreak/>
		<LineBreak/>
		4. (S) Die Armee hat den Luftwaffenstützpunkt Chitose eingenommen, Ihre Flugzeuge können von dort operieren.
		<LineBreak/>
		<LineBreak/>
		5. (S) {TaskForceName} eskortiert nach Abschluss des Nachschubs den Petropawlowsker Nachschubverband zur Tsugaru-Straße. Viel Glück, Genosse.
		<LineBreak/>
		<LineBreak/>
		GEZ.: Khvatov
		<LineBreak/>
		KTOF
		<LineBreak/>
		<LineBreak/>
		GEHEIM
		<LineBreak/>
		DECL OADR BT
	  </TextBlock>
</Grid>
