<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
	<!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" Text="1985-8-18" FontSize="{StaticResource Font.Size.Header}"/-->
	<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="{StaticResource Font.Size.Header}">
		IMMEDIATE
		<LineBreak/>
		O 08 2330Z FEB 88
	</TextBlock>
    <!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Text="05:00Z (06:00L)" FontSize="{StaticResource Font.Size.Header}"/-->

    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="FM"/>
    <TextBlock Grid.Row="3" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="RED BANNER PACIFIC FLEET"/>
    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="TO"/>
    <TextBlock Grid.Row="4" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="CO {TaskForceName}"/>
	<TextBlock Grid.Row="5" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="INFO"/>
    <TextBlock Grid.Row="5" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}">
		10th OPERATIONAL SQN
	</TextBlock>
    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="SUBJ"/>
    <TextBlock Grid.Row="7" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="WARNING ORDER - TRANSIT"/>
    <TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="{StaticResource Font.Size.Header}" TextWrapping="Wrap">
		TOP SECRET - EYES ONLY CO {TaskForceName}
		<LineBreak/>
		<LineBreak/>
		1. (S) {TaskForceName} will transit the Soya Strait, IAW original sailing plan. 
		<LineBreak/>
		<LineBreak/>
		2. (TS) Order "Climb Mt Klyuchevskaya" will be executed at 0900 local time. BPT conduct offensive operations against any American or Japanese assets. 
		<LineBreak/>
		<LineBreak/>
		3. (TS) A JMSDF SAG has been shadowing your force for the last 12 hours. Destroy it when Order "Climb Mt Klyuchevskaya" is executed. 
		<LineBreak/>
		<LineBreak/>
		4a. (S) USAF Misawa Air Base and JMSDF Hachinohe Air Base are located 300nm South of you. Expect F-4 and P-3 flights flights from this direction. 
		<LineBreak/>
		<LineBreak/>
		4b. (TS) {TaskForceName} shall not engage these airbases, other assets will neutralise IAW Order "Climb Mt Klyuchevskaya".
		<LineBreak/>
		<LineBreak/>
		5. (S) SIGINT suggests possible JMSDF SSK West of Soya Strait. 
		<LineBreak/>
		<LineBreak/>
		6. (S) Preserve your Task Force and ensure you reach the Sea of Okhotsk. Good luck, Comrade. 
		<LineBreak/>
		<LineBreak/>
		SIGNED: Khvatov
		<LineBreak/>
		KTOF
		<LineBreak/>
		<LineBreak/>
		TOP SECRET - EYES ONLY CO {TaskForceName}
		<LineBreak/>
		DECL OADR BT
	  </TextBlock>
</Grid>