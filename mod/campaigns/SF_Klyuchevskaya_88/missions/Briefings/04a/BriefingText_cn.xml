<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
	<!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" Text="1985-8-18" FontSize="{StaticResource Font.Size.Header}"/-->
	<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="{StaticResource Font.Size.Header}">
		紧急
		<LineBreak/>
		O 16 1100Z FEB 88
	</TextBlock>
    <!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Text="05:00Z (06:00L)" FontSize="{StaticResource Font.Size.Header}"/-->

    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="发报"/>
    <TextBlock Grid.Row="3" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="红旗太平洋舰队"/>
    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="收报"/>
    <TextBlock Grid.Row="4" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="K-242指挥官"/>
	<TextBlock Grid.Row="5" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="抄送"/>
    <TextBlock Grid.Row="5" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}">
		第10潜艇支队
	</TextBlock>
    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="主题"/>
    <TextBlock Grid.Row="7" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="作战命令"/>
    <TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="{StaticResource Font.Size.Header}" TextWrapping="Wrap">
		机密
		<LineBreak/>
		<LineBreak/>
		1. (S) K-242将消灭日本海上自卫队第2舰队护卫部队。
		<LineBreak/>
		<LineBreak/>
		2. (S) 榛名号（DDH-141）和鞍马号（DDH-144）为优先目标，预计位于特遣舰队中央。可能的护航舰包括1艘导弹驱逐舰及2艘以上驱逐舰。
		<LineBreak/>
		<LineBreak/>
		3. (S) 预计敌方空中力量强大。第2舰队护卫部队自带6架HSS-2B反潜直升机。日本海上自卫队驱逐舰还支持防区外反潜无人机。以厚木空军基地为基地的敌方海上巡逻机可能也在该区域内。
		<LineBreak/>
		<LineBreak/>
		4. (S) 目前敌方潜艇活动情况不明。
		<LineBreak/>
		<LineBreak/>
		5. (S) 请注意，友军核动力巡航导弹潜艇K-175正在你部东南方向执行独立任务。祝你好运，同志。
		<LineBreak/>
		<LineBreak/>
		SIGNED: 赫瓦托夫
		<LineBreak/>
		KTOF
		<LineBreak/>
		<LineBreak/>
		机密
		<LineBreak/>
		DECL OADR BT
	  </TextBlock>
</Grid>
