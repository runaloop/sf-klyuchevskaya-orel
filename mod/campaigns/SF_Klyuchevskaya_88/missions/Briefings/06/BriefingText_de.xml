<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
	<!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" Text="1985-8-18" FontSize="{StaticResource Font.Size.Header}"/-->
	<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="{StaticResource Font.Size.Header}">
		SOFORT
		<LineBreak/>
		O 21 2300Z FEB 88
	</TextBlock>
    <!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Text="05:00Z (06:00L)" FontSize="{StaticResource Font.Size.Header}"/-->

    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="VON"/>
    <TextBlock Grid.Row="3" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="ROTBANNER-PAZIFIKFLOTTE"/>
    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="AN"/>
    <TextBlock Grid.Row="4" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="KOMMANDANT {TaskForceName}"/>
	<TextBlock Grid.Row="5" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="INFO"/>
    <TextBlock Grid.Row="5" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}">
		10. OPERATIVE STAFFEL<LineBreak/>14. LANDUNGSSCHIFFS-BRIGADE<LineBreak/>55. DIVISION DER MARINEINFANTERIE
	</TextBlock>
    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="BETR"/>
    <TextBlock Grid.Row="7" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="OPERATIONSBEFEHL"/>
    <TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="{StaticResource Font.Size.Header}" TextWrapping="Wrap">
		GEHEIM
		<LineBreak/>
		<LineBreak/>
		1. (S) {TaskForceName} räumt den Landekopf und eskortiert die 14. Landungsschiffs-Brigade zum Landungsgebiet.
		<LineBreak/>
		<LineBreak/>
		2. (S) Mögliche feindliche Raketenboote im Raum, sichern Sie die Tsugaru-Straße gegen küstennahe Angriffsboote.
		<LineBreak/>
		<LineBreak/>
		3. (S) Feindliche U-Boot-Kräfte im Raum nicht erwartet. Feindlicher Luftwiderstand nach Neutralisierung des Luftwaffenstützpunkts Misawa gering erwartet.
		<LineBreak/>
		<LineBreak/>
		4. (S) Feindliche Landstreitkräfte im ganzen Raum verschanzt. Priorisieren Sie feindliche Artillerie und Flugabwehrstellungen.
		<LineBreak/>
		<LineBreak/>5. (S) Befreundete Luftstreitkräfte aus Fokino auf dem Weg zur Unterstützung der Landung. Überlebende Flugzeuge werden Ihrer Task Force zugeteilt.
		<LineBreak/>
		<LineBreak/>
		6. (S) {TaskForceName} verlegt nach Osten, um mit dem Nachschubverband aus Petropawlowsk zusammenzutreffen. Viel Glück, Genosse.
		<LineBreak/>
		<LineBreak/>
		GEZ.: Khvatov
		<LineBreak/>
		KTOF
		<LineBreak/>
		<LineBreak/>
		GEHEIM
		<LineBreak/>
		DECL OADR BT
	  </TextBlock>
</Grid>
