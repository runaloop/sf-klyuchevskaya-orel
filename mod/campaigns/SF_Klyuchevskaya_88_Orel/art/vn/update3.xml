<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="ĐIỆN VĂN HẢI QUÂN" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******M Ậ T*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="BỘ HẢI QUÂN" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					THƯỢNG KHẨN
					<LineBreak/>
					O 09 0200Z FEB 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="TỪ"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="HẠM ĐỘI THÁI BÌNH DƯƠNG CỜ ĐỎ"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="GỬI"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="TƯ LỆNH"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="SAO GỬI"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="LIÊN ĐỘI TÁC CHIẾN 10"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="SƯ ĐOÀN KHÔNG QUÂN TÊN LỬA HẢI QUÂN 143"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="SƯ ĐOÀN TÀU NGẦM 10"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="CHỦ ĐỀ"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="BÁO CÁO TÌNH HÌNH HÀNG NGÀY"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					MẬT
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (S) TÓM TẮT: Các hoạt động hải quân hôm nay rất thành công, đẩy lùi các phương tiện mặt nước của địch khỏi biển Nhật Bản và biển Okhotsk. Các cuộc tấn công của VVS vào hạ tầng Nhật Bản đạt kết quả khá tốt. Lục quân đã thiết lập được đầu cầu tại Sapporo.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) TÌNH TRẠNG ĐỊCH:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- CONSTELLATION, KITTY HAWK và các tàu hộ tống đi cùng đã bị tấn công phối hợp trên không và dưới mặt nước. Hiện chưa có đánh giá thiệt hại (BDA). Một số đơn vị của nhóm này được ghi nhận đang rút về phía nam qua eo biển Tsushima.
					<LineBreak/>
					- RANGER, MIDWAY và các tàu hộ tống đi cùng bị mai phục trong đòn tập kích đa hướng của TU-22. RANGER được xác nhận đã bị đánh chìm, MIDWAY được xác nhận bị hư hại nặng và đang rút về Pearl Harbor với tốc độ 5 hải lý/giờ.
					<LineBreak/>
					- NIMITZ đã ra khơi vào lúc 08 1200Z FEB 88, hướng về phía nam tới Okinawa.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) TÌNH TRẠNG TA:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- SF Klyuchevskaya tiếp tục di chuyển tới Bắc Thái Bình Dương qua quần đảo Kuril và chuẩn bị cho các hoạt động tập kích tuyến vận tải thương mại.
					<LineBreak/>
					- Sư đoàn Không quân Tên lửa Hải quân 143 giảm cường độ hoạt động và duy trì sẵn sàng cho các mục tiêu phát sinh.
					<LineBreak/>
					- Sư đoàn Tàu ngầm 10 sẽ bố trí các tàu ngầm SSN tại biển Hoa Đông và Tây Thái Bình Dương để thực hiện nhiệm vụ cắt đứt tuyến vận tải thương mại.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) TÌNH TRẠNG ĐỒNG MINH / KHU VỰC: Chiến dịch đổ bộ đường biển của Lục quân tại Sapporo đã thành công, đầu cầu được củng cố và các lực lượng tiếp theo đang đổ bộ. Lục quân báo cáo Nhật Bản kháng cự quyết liệt tại các vùng ngoại ô đô thị.
					<LineBreak/>
					<LineBreak/>
					Các cuộc tấn công của Không quân Tầm xa vào các căn cứ không quân Nhật Bản đạt kết quả một phần. Các căn cứ Misawa, Hachinohe và Atsugi đã bị tập kích nhưng máy bay của địch trên mặt đất chỉ chịu thiệt hại tối thiểu.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) NHẬN XÉT CỦA TƯ LỆNH: Tình hình hiện tại đang có lợi cho ta. Điều cốt yếu là không để lực lượng tăng viện của Mỹ đến được Nhật Bản. Chờ thông tin xác định mục tiêu đoàn tàu vận tải. KTOF gửi.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					KÝ: Khvatov
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					MẬT DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
