            <LineBreak/>
               1 - Cục 6 GRU
            <LineBreak/>
               1 - Cục 12 GRU
          </TextBlock>
          <TextBlock Grid.Row="4" Text="TỐI MẬT" TextAlignment="Center"/>
        </Grid>
      </Border>
    </Border>
  </Viewbox>
</Page>
