<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="MARINEMELDUNG" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******G E H E I M*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="MARINEMINISTERIUM" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					SOFORT
					<LineBreak/>
					O 09 0200Z FEB 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="VON"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="ROTBANNER-PAZIFIKFLOTTE"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="AN"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="KOMMANDANT"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="KOPIE"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10. OPERATIVE STAFFEL"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="143. SEEFLIEGER-RAKETENDIVISION"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="10. U-BOOT-DIVISION"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="BETR"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="TAGESLAGEBERICHT"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					GEHEIM
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (S) ZUSAMMENFASSUNG: Die heutigen Seeoperationen waren sehr erfolgreich, feindliche Überwasserkräfte wurden aus dem Japanischen Meer und dem Ochotskischen Meer verdrängt. Die Angriffe der VVS auf japanische Infrastruktur waren mäßig erfolgreich. Die Armee hat einen Brückenkopf bei Sapporo errichtet.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) FEINDLAGE:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- CONSTELLATION, KITTY HAWK und zugeteilte Geleitschiffe in einem kombinierten Luft- und Unterwasserangriff getroffen. Zur Zeit keine Erfolgsauswertung. Teile dieser Streitmacht wurden beim Rückzug nach Süden durch die Tsushima-Straße gesichtet.
					<LineBreak/>
					- RANGER, MIDWAY und zugeteilte Geleitschiffe in einem mehrachsigen Tu-22-Angriff überfallen. RANGER als versenkt bestätigt, MIDWAY als schwer beschädigt bestätigt und mit 5 kn Rückzug nach Pearl Harbor.
					<LineBreak/>
					- NIMITZ um 08 1200Z FEB 88 auslaufend, Kurs Süd auf Okinawa.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) EIGENE LAGE:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- SF Klyuchevskaya setzt den Übergang in den Nordpazifik über die Kurilen fort und bereitet sich auf Operationen zur Handelsschifffahrtsjagd vor.
					<LineBreak/>
					- Die 143. Seeflieger-Raketendivision reduziert den Einsatzumfang und hält Bereitschaft für Gelegenheitsziele.
					<LineBreak/>
					- Die 10. U-Boot-Division positioniert SSNs im Ostchinesischen Meer und im Westpazifik für Aufträge zur Handelssperre.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) LAGE VERBÜNDETER / REGIONALE LAGE: Die amphibische Landung der Armee bei Sapporo war erfolgreich, der Brückenkopf ist gesichert und Folgestreitkräfte landen. Die Armee meldet zähen japanischen Widerstand in den städtischen Außenbezirken.
					<LineBreak/>
					<LineBreak/>
					Die Angriffe der Langstreckenfliegerkräfte gegen japanische Luftwaffenstützpunkte waren teilweise erfolgreich. Die Stützpunkte Misawa, Hachinohe und Atsugi wurden getroffen, jedoch mit minimalen Verlusten an feindlichen Flugzeugen am Boden.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) ANMERKUNGEN DES KOMMANDEURS: Die gegenwärtige Lage ist zu unseren Gunsten. Es ist entscheidend, dass amerikanische Verstärkungen Japan nicht erreichen. Warten Sie auf Zielinformationen zu Konvois. KTOF sendet.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					GEZEICHNET: Khvatov
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					GEHEIM DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
