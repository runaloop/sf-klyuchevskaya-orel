<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>
		
        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			
			<TextBlock Grid.Row="0" Grid.Column="0" Text="NAVAL MESSAGE" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******S E C R E T*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="NAVY DEPARTMENT" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
			
		</Grid>
		
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					IMMEDIATE
					<LineBreak/>
					O 09 0200Z FEB 88
				</TextBlock>
				
				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="FM"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="RED BANNER PACIFIC FLEET"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="TO"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="COMMANDER"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="INFO"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10th OPERATIONAL SQN"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="143rd MARITIME MISSILE AVIATION DIV"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="10th SUBMARINE DIV"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="SUBJ"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="DAILY SITREP"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					SECRET
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (S) SUMMARY: Today's naval operations highly successful with enemy surface assets pushed out of Sea of Japan and Sea of Ohkotsk. VVS attacks against Japanese infrastructure moderately successful. Army has established foothold in Sapporo. 
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) ENEMY STATUS:
				</TextBlock>	
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">	
					- CONSTELLATION, KITTY HAWK and attached escorts hit in combined air and submerged attack. No BDA at this time. Elements of this force seen withdrawing South through Tsushima Strait. 
					<LineBreak/>
					- RANGER, MIDWAY and attached escorts ambushed in multi-axis TU-22 strike. RANGER confirmed sunk, MIDWAY confirmed heavily damaged and withdrawing to Pearl Harbour at 5 kts. 
					<LineBreak/>
					- NIMITZ put to sea at 08 1200Z FEB 88, heading South for Okinawa. 
					<LineBreak/>
				</TextBlock>	
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) FRIENDLY STATUS:
				</TextBlock>	
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">	
					- SF Klyuchevskaya continue transiting to North Pacific via Kuril Islands and prepare for commerce raiding operations. 
					<LineBreak/>
					- 143rd Maritime Missile Aviation Division reduce operations and maintain readiness for targets of opportunity. 
					<LineBreak/>
					- 10th Submarine Division shall position SSNs in East China Sea and Western Pacific for trade interdiction taskings. 
					<LineBreak/>
				</TextBlock>	
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) ALLIED / REGIONAL STATUS: Army amphibous landing in Sapporo successful with beachhead secured and follow-on forces landing. Army reports stiff Japanese resistance in urban outskirts. 
					<LineBreak/>
					<LineBreak/>
					Long Range Aviation attacks against Japanese airbases partially successful. Misawa, Hachinohe and Atsugi airbases hit but with minimal losses to enemy aircraft on ground. 
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) COMMANDER'S COMMENTS: Situation at present is in our favor. It is essential that American reinforcements do not make it to Japan. Await convoy targeting info. KTOF sends.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					SIGNED: Khvatov
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					SECRET DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
