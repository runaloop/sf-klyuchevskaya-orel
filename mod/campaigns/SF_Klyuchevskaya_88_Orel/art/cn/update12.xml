<!-- Pacific Strike CIA memorandum event, adapted from Strike Group Molniya U.S.-voice interstitial format. -->
<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080">
  <Viewbox>
    <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Width="864" Height="1120" Padding="45"
            TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16">
      <Border.Effect>
        <DropShadowEffect />
      </Border.Effect>

      <Border BorderThickness="0,10,10,10" BorderBrush="#FF000000">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="C05084534" Background="#FFFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,-15,0,0" Padding="5,0,5,0" />
          <Grid Grid.Row="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="15"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="15"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="绝密" TextAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2" TextAlignment="Center" FontFamily="Times New Roman">
              总参谋部情报总局
              <LineBreak/>
              <LineBreak/>
              <Run FontSize="12">莫斯科，62665</Run>
            </TextBlock>
            <TextBlock Grid.Row="4" Grid.Column="3" Text="1988年2月17日"/>
            <TextBlock Grid.Row="6" Grid.Column="3" Text="222X1"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="备忘录呈送："/>
            <TextBlock Grid.Row="7" Grid.Column="1" TextWrapping="Wrap">
              苏联海军总司令部
              <LineBreak/>
              红旗太平洋舰队
              <LineBreak/>
              第10潜艇支队//情报处//
              <LineBreak/>
              第11潜艇支队//情报处//
            </TextBlock>
            <TextBlock Grid.Row="7" Grid.Column="3" TextWrapping="Wrap">
              EO 13526 3.3(b)(1)&gt;25Yrs
              <LineBreak/>
              EO 13526 3.5(c)
            </TextBlock>
            <TextBlock Grid.Row="9" Grid.Column="0" Text="主题："/>
            <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Text="尼米兹号航母战斗群指挥网美方通信"/>
          </Grid>
          <TextBlock Grid.Row="2" TextWrapping="Wrap">
            1. 信号情报站"瓦良格"截获美方指挥通信，内容涉及尼米兹补给船队被摧毁一事。通信内容显示，美方对尼米兹号航母战斗群的再武装和加油深感忧虑，并担心西太平洋地区将只剩陆基空中力量可用。
            <LineBreak/>
            <LineBreak/>
            2. 鉴于苏联水面和水下力量正拦截夏威夷至硫磺岛之间的补给线，美国海军指挥频道已指示尼米兹号航母战斗群全速驶向珍珠港。尼米兹号所接命令要求以最高速度航渡，无需进行反潜蛇形规避机动，通信中还对美国海军航母反潜机掩护航母战斗群、防范友军潜艇的能力表示乐观。
            <LineBreak/>
            <LineBreak/>
            3. 预计尼米兹号航母战斗群将把有限的航空燃油储备集中用于反潜飞行，从而降低反舰和战斗巡逻的出动率。
            <LineBreak/>
            <LineBreak/>
			4. 美方指挥官已意识到，其有限的陆基和舰载空中力量不足以阻止我方对东京的合围，或阻止我方完成对日本的占领。鉴于太平洋战区尚存2支具备作战能力的航母战斗群，格鲁乌判断，摧毁其中任意一支航母战斗群都将导致敌方在日本的抵抗崩溃，并很可能促使苏美两国开始和平谈判。
            <LineBreak/>
            <LineBreak/>
          </TextBlock>
          <TextBlock TextAlignment="Right" Text="弗拉德连·米哈伊洛夫，局长" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="480,500,0,0" Grid.Row="2"/>
          <TextBlock Grid.Row="2" Grid.RowSpan="3" VerticalAlignment="Bottom">
            <Run TextDecorations="Underline">分发：ER/1988年3月1日 附件</Run>
            <LineBreak/>
            <LineBreak/>
            正本——各收件方
            <LineBreak/>
               1份——格鲁乌第2局
            <LineBreak/>
               1份——格鲁乌第6局
            <LineBreak/>
               1份——格鲁乌第12局
          </TextBlock>
          <TextBlock Grid.Row="4" Text="绝密" TextAlignment="Center"/>
        </Grid>
      </Border>
    </Border>
  </Viewbox>
</Page>
