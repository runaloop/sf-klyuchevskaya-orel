<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="해군 통신문" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******비밀*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="해군성" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					긴급
					<LineBreak/>
					O 08 0200Z MAR 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="발신"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="붉은기 태평양 함대"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="수신"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="지휘관"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="참조"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="제10작전전대"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="제11작전전대"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="제10잠수함사단"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="제목"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="일일 상황보고"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					비밀
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (S) 요약: 클류쳅스카야 기동부대와 나로드 기동부대가 사세보에 정박 중. 괌은 키티 호크의 항모 항공전력으로 크게 증강됨. 컨스텔레이션 항모전투단은 괌으로 향하는 것으로 보이며, 도착 예정은 4일 이내임. 컨스텔레이션이 괌에 도달하면, 미 해군 항모전투단과 증강된 USAF 기지의 결합 항공전력으로 미국은 일본에 대한 폭격을 아무런 제약 없이 실시할 수 있게 됨.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (S) 적 상황:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- 컨스텔레이션은 06 2343Z MAR 88 기준 하와이 서쪽 300해리에서 위치 확인. 호위 전력에는 최소 CG 2척, DD 2척, 신형 올리버 해저드 페리급 장선체 파생형 3척 이상이 포함됨. 항로와 속력을 볼 때 4일 내 괌 항공엄호권에 진입할 것으로 예상됨.
					<LineBreak/>
					- 키티 호크는 07 0015Z MAR 88 기준 하와이 동쪽 500해리에서 위치 확인, 샌디에이고로 이동 중인 것으로 보임. 국가 기술 수단에 따르면 이 항모는 대규모 수리를 위해 미 본토로 이동 중인 것으로 판단됨.
					<LineBreak/>
					- 오키나와와 이오지마는 어제 VVS 장거리 항공대에 의해 제압됨. 양쪽 비행장 모두 무력화됨. 이 지역에서 적 공중 활동은 없을 것으로 예상됨.
					<LineBreak/>
					- 괌은 서유럽에서 이동한 HAWK 포대로 증강됨. HUMINT에 따르면 20시간 전 키티 호크로 추정되는 항모 항공기 3개 편대 이상이 그곳에 착륙함.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) 우군 상황:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- 클류쳅스카야 기동부대는 북방 함대 증원 전력과 함께 향후 24시간 내 컨스텔레이션 항모전투단을 상대로 출격할 것.
					<LineBreak/>
					- 제143해군미사일항공사단은 계속 높은 경계 상태를 유지. 사단 전체가 클류쳅스카야 기동부대의 다가올 출격을 지원하기 위해 일본으로 재배치됨.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) 동맹/지역 상황: 육군은 괌에 대한 항공작전을 준비하며 오키나와 및 이오지마 상륙을 준비 중.
					<LineBreak/>
					VVS 장거리 항공대는 괌에 대한 항공작전에 대비해 작전 속도를 줄이고 있음.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) 지휘관 의견: 미 제7함대에는 이제 항모가 한 척밖에 남지 않음. 컨스텔레이션을 격침하면 미국은 협상 테이블로 나올 수밖에 없을 것임. 전쟁의 끝이 보임. KTOF 발신.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					서명: 흐바토프
					<LineBreak/>
					KTOF
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					비밀 DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
