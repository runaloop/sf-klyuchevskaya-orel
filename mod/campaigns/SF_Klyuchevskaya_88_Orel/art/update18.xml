<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080">
  <Viewbox>
    <Border Background="#F3E8CF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="920" Height="1270" Padding="44"
            TextElement.FontFamily="Times New Roman" TextElement.Foreground="#111111" TextElement.FontSize="17">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.45"/>
      </Border.Effect>
      <StackPanel Orientation="Vertical">
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>
        <TextBlock Text="20 MARCH 1988 | ASIA OBSERVER | 30 Cents" Margin="0,14,0,14" FontSize="23" TextAlignment="Center"/>
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>

        <Grid Margin="0,8,0,12">
          <Rectangle Fill="#9B1C1C" Height="16" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
          <TextBlock Text="BREAKING NEWS" TextAlignment="Center" FontSize="72" FontWeight="Bold"/>
        </Grid>
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>

        <TextBlock Text="PEACE TALKS CONCLUDE IN SWITZERLAND"
                   FontWeight="Bold" FontSize="36" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,12"/>
        <TextBlock Text="Soviet and American diplomats sign non-binding peace treaty."
                   FontSize="24" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>

        <Border BorderBrush="#111111" BorderThickness="3" Background="#FFF7DD" Padding="14" Margin="0,0,0,18">
          <TextBlock Text="Tense but peaceful withdrawal as Soviet and American forces return to peacetime operations."
                     FontSize="28" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="3*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="ZURICH" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="24">
              The Soviet and American Foreign Ministers signed a non-binding peace treaty today. This treaty splits the former Nation of Japan into socialist and democratic blocs. 
              <LineBreak/><LineBreak/>
              Soviet occupied Hokkaido and Japanese main islands relinquished to a new "People's Republic of Japan", Okinawa and Iwo Jima retained under democratic Japanese control. 
              <LineBreak/><LineBreak/>
              Foreign observers note absence of Japanese delegation throughout the treaty process. 
            </TextBlock>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="WASHINGTON" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="24">
              Outrage and mourning throughout the US today as the full extent of American losses are publicized. 
              <LineBreak/><LineBreak/>
              American officals face heavy scrutiny over poor performance in Western Pacific. 
              <LineBreak/><LineBreak/>
              The Soviet embassy in Washington promise swift repatriation of captured American personnel.  
            </TextBlock>
          </StackPanel>
        </Grid>

        <Border BorderBrush="#111111" BorderThickness="2" Padding="12" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="TENSION GROWS IN NATO" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="23">
              The US president questioned Western Europe's willingness to fight today, claiming they have fallen to communist political manipulation. 
			  <LineBreak/><LineBreak/>
			  Analysts caution against European willingness to accept Soviet oil and gas, and the dangers of linking Western economies to a "expansionist" and "authoritarian" Soviet state. 
            </TextBlock>
          </StackPanel>
        </Border>

        <Rectangle HorizontalAlignment="Stretch" Height="3" Fill="#111111"/>
        <TextBlock Text="Inside: Elections in Soviet Japan next week | Analysing 32 years of the US-Japan Security Treaty | US Joint Chiefs resign in protest of peace agreement" TextWrapping="Wrap" FontSize="17" Margin="0,12,0,10" TextAlignment="Center"/>
        <TextBlock Text="-1-" TextAlignment="Center" FontSize="16"/>
      </StackPanel>
    </Border>
  </Viewbox>
</Page>
