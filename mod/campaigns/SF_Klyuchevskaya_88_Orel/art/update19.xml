<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Stretch="Uniform"
  StretchDirection="Both">
  <Grid Width="1560" Height="920" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.RowDefinitions>
      <RowDefinition Height="90"/>
      <RowDefinition Height="1"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="SF Klyuchevskaya '88" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="28,0"/>

    <StackPanel Grid.Row="2" Margin="170,90,170,0">
      <TextBlock Text="Campaign Complete" FontSize="20" Foreground="#AEB7C0" HorizontalAlignment="Center" Margin="0,0,0,24"/>
      <TextBlock Text="Thanks for Playing" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,28"/>
      <TextBlock TextWrapping="Wrap" FontSize="18" LineHeight="30" Foreground="#D0D4D8">
		Thanks for playing SF Klyuchevskaya '88. 
        <LineBreak/><LineBreak/>
		This is my first campaign, built around historically accurate units, and heavily inspired by a certain campaign in Wargame:Red Dragon. 
		<LineBreak/><LineBreak/>
		I hope this was an exciting and educational experience pitting the Soviet Union's best against conventional USN superiority. 
		<LineBreak/><LineBreak/>
        Part Two will likely be released once the JMSDF FRAM ships, USN Mk41 cruisers, and Royal Navy are added to the game.
      </TextBlock>
    </StackPanel>
  </Grid>
</Viewbox>
