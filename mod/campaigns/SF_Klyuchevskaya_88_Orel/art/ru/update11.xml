<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="ВОЕННО-МОРСКОЕ СООБЩЕНИЕ" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******С Е К Р Е Т Н О*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="ВОЕННО-МОРСКОЕ ВЕДОМСТВО" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					СРОЧНОЕ СООБЩЕНИЕ
					<LineBreak/>
					O 28 0200Z ФЕВ 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="ОТ КОГО"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="КРАСНОЗНАМЁННЫЙ ТИХООКЕАНСКИЙ ФЛОТ"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="КОМУ"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="КОМАНДИРУ"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="КОПИЯ"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10-Я ОПЕРАТИВНАЯ ЭСКАДРА"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="55-Я ДИВИЗИЯ МОРСКОЙ ПЕХОТЫ"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="14-Я БРИГАДА ДЕСАНТНЫХ КОРАБЛЕЙ"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="ТЕМА"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="ЕЖЕДНЕВНАЯ СВОДКА"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					СЕКРЕТНО
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (С) ОБЩАЯ ОБСТАНОВКА: Армия вышла на окраины Токио, армия выделила половину своих сил для рывка на Китакюсю, чтобы не дать японским войскам вырваться из Токио.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (С) ОБСТАНОВКА ПРОТИВНИКА:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					— Кусирский котёл капитулировал 3 часа назад; Хоккайдо полностью принадлежит СССР, переход к социалистическому правительству завершён.
					<LineBreak/>
					— КОНСТЕЛЛЕЙШН обнаружен у пирса в Пёрл-Харборе в 27 2345Z ФЕВ 88. По данным технических средств разведки, он и его корабли охранения пополняют запасы, вероятный выход в море — в течение следующих 48 часов.
					<LineBreak/>
					— НИМИЦ обнаружен в 500 морских милях северо-восточнее Иводзимы в 24 2228Z ФЕВ 88, по всей видимости удерживает позицию.
					<LineBreak/>
					— Крупный конвой вышел из Пёрл-Харбора около 27 1800Z ФЕВ 88. Группа, по всей видимости, следует на сближение с авианосной группой НИМИЦ, ожидаемое время прибытия — 2 марта 1988. По оценке радиоразведки, это отряд снабжения для авианосной группы НИМИЦ.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (С) СОБСТВЕННАЯ ОБСТАНОВКА:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					— КУГ «Ключевская» находится в оперативном районе «БОГАТЫРЬ», выдвинется на перехват отряда снабжения НИМИЦ до его выхода под прикрытие авиации авианосной группы НИМИЦ.
					<LineBreak/>
					— 55-я дивизия морской пехоты присоединяется к наступлению на Токио.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (С) ОБСТАНОВКА У СОЮЗНИКОВ / В РЕГИОНЕ: Армейский отряд подходит к окраинам Нагои; окружение Токио ожидается в течение следующих 48 часов. Армия сообщает об ограниченном сопротивлении японцев в сельской местности, однако на окраинах Токио сопротивление упорное.
					<LineBreak/>
					Части 11-й дивизии подводных лодок Краснознамённого Северного флота завершили переход через Северный полярный круг и переданы в подчинение КТОФ.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (С) КОММЕНТАРИИ КОМАНДУЮЩЕГО: КГБ сообщает, что его подразделения безопасности ликвидировали партизан на Хоккайдо и на главных островах Японии. По их утверждению, местное сопротивление в основном подавлено — похоже, второго Афганистана не будет. Теперь вопрос в том, сможем ли мы прижать к стенке и уничтожить оставшиеся авианосные группы ВМС США. КТОФ передаёт.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					ПОДПИСАЛ: Хватов
					<LineBreak/>
					КТОФ
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					СЕКРЕТНО DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
