<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>

        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="ВОЕННО-МОРСКОЕ СООБЩЕНИЕ" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="*******С О В Е Р Ш Е Н Н О   С Е К Р Е Т Н О*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="ВОЕННО-МОРСКОЕ ВЕДОМСТВО" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

		</Grid>

		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					СРОЧНОЕ СООБЩЕНИЕ
					<LineBreak/>
					O 08 0800Z ФЕВ 88
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 0808100"/>


				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="ОТ КОГО"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="КРАСНОЗНАМЁННЫЙ ТИХООКЕАНСКИЙ ФЛОТ"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="КОМУ"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="КОМАНДИРУ"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
					<Run Text="ФОКИНО, ПРИМОРСКИЙ КРАЙ"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="КОПИЯ"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="10-Я ОПЕРАТИВНАЯ ЭСКАДРА"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="143-Я МОРСКАЯ РАКЕТОНОСНАЯ АВИАЦИОННАЯ ДИВИЗИЯ"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="10-Я ДИВИЗИЯ ПОДВОДНЫХ ЛОДОК"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="ТЕМА"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="ПЛАН «ОРАНЖ» 1-4"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					СОВЕРШЕННО СЕКРЕТНО - ТОЛЬКО ДЛЯ ЛИЧНОГО ОЗНАКОМЛЕНИЯ
					<LineBreak/>
					BT
					<LineBreak/>
					<LineBreak/>
					1. (СС) КРАТКО: Недавние вторжения на советскую территорию указывают на неминуемое вторжение Японии и США на советский Дальний Восток. Главное командование Красного флота отдало приказ о немедленном приведении в действие плана «Оранж» 1-4. Всем наличным советским силам приказано подготовиться к боевым действиям против Японии и 7-го флота США.
					<LineBreak/>
					<LineBreak/>
					Начало боевых действий — по сигналу «Восхождение на Ключевскую» в 09 0000Z ФЕВ 88.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" TextWrapping="Wrap">
					2. (СС) ПОЛОЖЕНИЕ ПРОТИВНИКА:
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- КОНСТЕЛЛЕЙШН, КИТТИ-ХОК и корабли охранения в Японском море проводят совместные операции с 1-й флотилией охранения флота Японии.
					<LineBreak/>
					- РЕЙНДЖЕР, МИДУЭЙ и корабли охранения в 200 морских милях южнее Петропавловска проводят операции совместно с десантными кораблями.
					<LineBreak/>
					- НИМИЦ у причала в Йокосуке, Япония.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (СС) ПОЛОЖЕНИЕ СВОИХ СИЛ:
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					- КУГ «Ключевская» на переходе к проливу Лаперуза сохраняет курс и прорывается в северную часть Тихого океана для действий против судоходства противника.
					<LineBreak/>
					- 143-я морская ракетоносная авиационная дивизия готовится к массированному удару по группе РЕЙНДЖЕР-МИДУЭЙ.
					<LineBreak/>
					- 10-я дивизия подводных лодок готовится к развёртыванию АПЛ и ПЛАРК в западной части Тихого океана и Японском море.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (СС) ПОЛОЖЕНИЕ СОЮЗНИКОВ / ОБСТАНОВКА В РЕГИОНЕ: ВВС и части Советской Армии готовятся к морскому и воздушному десанту против Саппоро, Япония. Замысел — рассечь Хоккайдо и разгромить японскую армию по частям превосходящими танковыми и механизированными силами. После взятия Хоккайдо дополнительные морские и воздушные десанты позволят быстро развить успех на главном острове.
					<LineBreak/>
					<LineBreak/>
					Кроме того, ВВС задействуют Дальнюю авиацию против японских авиабаз в регионе. Нейтрализация авиабаз противника значительно снизит угрозу для своих надводных и подводных сил.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (СС) ЗАМЫСЕЛ КОМАНДОВАНИЯ: Замысел операции — стремительное уничтожение японских и американских морских сил в регионе, что позволит надводным и подводным силам блокировать Японию, уничтожая её судоходство. Изоляция Японии позволит своим наземным силам сломить оборону противника и занять весь остров. Следует избегать вовлечения нейтральных сторон. Эта война должна остаться региональной и не затронуть НАТО и другие западные страны. КТОФ передаёт.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					ПОДПИСАЛ: Хватов
					<LineBreak/>
					КТОФ
					<LineBreak/>
					<LineBreak/>
					BT
					<LineBreak/>
					СОВЕРШЕННО СЕКРЕТНО - ТОЛЬКО ДЛЯ ЛИЧНОГО ОЗНАКОМЛЕНИЯ DECL OADR
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
