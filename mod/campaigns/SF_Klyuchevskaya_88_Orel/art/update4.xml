<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080">
  <Viewbox>
    <Border Background="#F3E8CF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="920" Height="1270" Padding="44"
            TextElement.FontFamily="Times New Roman" TextElement.Foreground="#111111" TextElement.FontSize="17">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.45"/>
      </Border.Effect>
      <StackPanel Orientation="Vertical">
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>
        <TextBlock Text="10 FEBUARY 1988 | ASIA OBSERVER | 30 Cents" Margin="0,14,0,14" FontSize="23" TextAlignment="Center"/>
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>

        <Grid Margin="0,8,0,12">
          <Rectangle Fill="#9B1C1C" Height="16" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
          <TextBlock Text="BREAKING NEWS" TextAlignment="Center" FontSize="72" FontWeight="Bold"/>
        </Grid>
        <Rectangle HorizontalAlignment="Stretch" Height="5" Fill="#111111"/>

        <TextBlock Text="SOVIETS LAND IN HOKKAIDO"
                   FontWeight="Bold" FontSize="36" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,12"/>
        <TextBlock Text="Tokyo confirms heavy fighting in Sapporo and neighbouring regions. "
                   FontSize="24" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>

        <Border BorderBrush="#111111" BorderThickness="3" Background="#FFF7DD" Padding="14" Margin="0,0,0,18">
          <TextBlock Text="Japanese officials claim heavy Soviet losses despite constant air attack."
                     FontSize="28" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="3*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="WASHINGTON" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="24">
              US 3rd Fleet orders all American and Japanese merchants to assemble at staging points off Anchorage, AK. 
              <LineBreak/><LineBreak/>
              US Naval Reservists called up for convoy duties, USNS ships reactivated for military shipping. 
              <LineBreak/><LineBreak/>
              Japanese and American tankers trapped in North Pacific sea lanes rush for safety. US 3rd Fleet confirms destroyers diverted to secure shipping lanes. 
            </TextBlock>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="MOSCOW CLAIMS DEFENSIVE ACTION" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="24">
              Soviet diplomatic corps say Japanese forces provoked war, present evidence from Japanese submarine sunk in Soviet territorial waters. Claim submarine had orders to attack Soviet warships. 
              <LineBreak/><LineBreak/>
              Soviet embassies in Europe suggest recent offensive merely to stop "Japanese aggression" and resurgent militarism. 
              <LineBreak/><LineBreak/>
              NATO governments push for peaceful resolution in Western Pacific. Anonymous officials claim military options "on the table" but there are other options.  
            </TextBlock>
          </StackPanel>
        </Grid>

        <Border BorderBrush="#111111" BorderThickness="2" Padding="12" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="ANONYMOUS SOURCES CLAIM SOVIET RAIDING FORCE DAMAGED IN NORTH PACIFIC" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Justify" LineHeight="23">
              Unnamed Japanese officials claim a small Soviet naval force failed an attempted breakthrough in the Sea of Ohktosk this morning. Initial reports suggest Soviet force suffered heavy losses from air and submarine attack. 
            </TextBlock>
          </StackPanel>
        </Border>

        <Rectangle HorizontalAlignment="Stretch" Height="3" Fill="#111111"/>
        <TextBlock Text="Inside: US Carriers in tense stalemate against Soviet bombers | Gas prices spike as Japanese refineries forced offline | Emergency sessions in European capitals" TextWrapping="Wrap" FontSize="17" Margin="0,12,0,10" TextAlignment="Center"/>
        <TextBlock Text="-1-" TextAlignment="Center" FontSize="16"/>
      </StackPanel>
    </Border>
  </Viewbox>
</Page>
