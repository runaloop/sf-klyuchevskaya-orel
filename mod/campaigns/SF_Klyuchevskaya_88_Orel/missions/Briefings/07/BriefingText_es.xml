<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
	<!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" Text="1985-8-18" FontSize="{StaticResource Font.Size.Header}"/-->
	<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="{StaticResource Font.Size.Header}">
		INMEDIATO
		<LineBreak/>
		O 26 0200Z FEB 88
	</TextBlock>
    <!--TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Text="05:00Z (06:00L)" FontSize="{StaticResource Font.Size.Header}"/-->

    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="DE"/>
    <TextBlock Grid.Row="3" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="FLOTA DEL PACÍFICO DE LA BANDERA ROJA"/>
    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="PARA"/>
    <TextBlock Grid.Row="4" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="COMANDANTE {TaskForceName}"/>
	<TextBlock Grid.Row="5" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="INFORMACIÓN"/>
    <TextBlock Grid.Row="5" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}">
		10.ª ESCUADRA OPERATIVA
	</TextBlock>
    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="ASUNTO"/>
    <TextBlock Grid.Row="7" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="ORDEN DE OPERACIONES"/>
    <TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="{StaticResource Font.Size.Header}" TextWrapping="Wrap">
		SECRETO
		<LineBreak/>
		<LineBreak/>
		1. (S) {TaskForceName} debe reabastecerse de la fuerza de reabastecimiento de Petropavlovsk.
		<LineBreak/>
		<LineBreak/>
		2. (S) Amenaza de submarino desconocida en el área; sin embargo, la 7ª Flota de la USN ha estado enviando SSN al Pacífico Occidental, y muchos SSK japoneses aún no han sido localizados.
		<LineBreak/>
		<LineBreak/>
		3. (S) Probable MPA de la USN en el área, realizando ataques de hostigamiento con AGM-84D HARPOON de alcance extendido.
		<LineBreak/>
		<LineBreak/>
		4. (S) El Ejército ha capturado la AFB de Chitose; tus aeronaves pueden desplegarse desde allí.
		<LineBreak/>
		<LineBreak/>
		5. (S) {TaskForceName} debe escoltar a la fuerza de reabastecimiento de Petropavlovsk hasta el Estrecho de Tsugaru una vez completado el reabastecimiento. Buena suerte, Camarada.
		<LineBreak/>
		<LineBreak/>
		FIRMADO: Khvatov
		<LineBreak/>
		KTOF
		<LineBreak/>
		<LineBreak/>
		SECRETO
		<LineBreak/>
		DECL OADR BT
	  </TextBlock>
</Grid>